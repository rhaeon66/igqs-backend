DJANGO_SECRET_KEY=replace-me-with-a-long-random-string
DJANGO_DEBUG=True
# Local only. Leave unset or False in production.
ADMIN_LOGIN_DISABLED=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Production: DJANGO_ALLOWED_HOSTS=igqs.orbeetal.com
FRONTEND_URL=http://localhost:3355
# Production: FRONTEND_URL=https://igqsbd.com
CORS_ALLOWED_ORIGINS=http://localhost:3355,http://127.0.0.1:3355
# Production: CORS_ALLOWED_ORIGINS=https://igqsbd.com,https://admin.igqsbd.com
CSRF_TRUSTED_ORIGINS=http://localhost:3355,http://127.0.0.1:3355
# Production: CSRF_TRUSTED_ORIGINS=https://igqsbd.com,https://admin.igqsbd.com
DEFAULT_FROM_EMAIL=IGQS Admissions <admissions@igqs.edu.bd>
STAFF_NOTIFICATION_EMAIL=
SMS_PROVIDER=
# Local default: console backend, prints emails to the runserver log.
# Production: DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
#   and set EMAIL_HOST / EMAIL_PORT / EMAIL_HOST_USER / EMAIL_HOST_PASSWORD below.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
STAFF_USERNAME=igqs
STAFF_PASSWORD=igqs-admin-2026
DJANGO_SUPERUSER_USERNAME=igqs
# This is a publicly documented example value. createsu refuses to use it in
# production (DJANGO_DEBUG=False) — set a unique password before deploying.
DJANGO_SUPERUSER_PASSWORD=igqs-admin-2026
DJANGO_SUPERUSER_EMAIL=admissions@igqs.edu.bd
